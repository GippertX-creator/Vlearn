{
  "name": "vlearn",
  "version": "3.0.0",
  "description": "Vlearn 教培机构教务与财务管理系统（本地桌面应用，数据存储于 SQLite）",
  "main": "out/main/index.js",
  "author": "Vlearn",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "smoke": "electron-vite build && electron out/main/index.js --smoke-test",
    "smoke:ui": "electron-vite build && electron out/main/index.js --smoke-ui",
    "postinstall": "node scripts/rebuild-native.js",
    "rebuild": "node scripts/rebuild-native.js",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@ant-design/icons": "^5.5.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "antd": "^5.21.2",
    "dayjs": "^1.11.13",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "marked": "^12.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
